{
  "name": "cc-agents-kit-doc",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/generate-static.mjs",
    "build:release": "node scripts/require-release-site-url.mjs && pnpm build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm build && pnpm verify:site:negative",
    "format": "prettier --write \"**/*.{css,html,js,json,mjs,ts,tsx,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{css,html,js,json,mjs,ts,tsx,yml,yaml}\"",
    "knip": "knip --no-progress",
    "lint": "pnpm lint:eslint && pnpm lint:oxlint",
    "lint:eslint": "eslint .",
    "lint:oxlint": "oxlint --deny-warnings .",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc -b --pretty false",
    "verify:site": "node scripts/verify-site.mjs",
    "verify:site:negative": "node scripts/verify-site.mjs --self-test"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "lucide-react": "^1.42.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "knip": "6.34.0",
    "oxlint": "1.82.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}
