{
  "name": "cc-agents-kit-doc",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/generate-static.mjs",
    "build:release": "node scripts/require-release-site-url.mjs && pnpm build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm test:unit && pnpm build && pnpm verify:site:negative && pnpm test:browser",
    "format": "prettier --write \"**/*.{css,html,js,json,mjs,ts,tsx,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{css,html,js,json,mjs,ts,tsx,yml,yaml}\"",
    "knip": "knip --no-progress",
    "lint": "pnpm lint:eslint && pnpm lint:oxlint",
    "lint:eslint": "eslint .",
    "lint:oxlint": "oxlint --deny-warnings .",
    "preview": "node scripts/preview.mjs",
    "test": "pnpm test:unit && pnpm build && pnpm test:browser",
    "test:browser": "playwright test",
    "test:unit": "node --test tools/*.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "verify:site": "node scripts/verify-site.mjs",
    "verify:site:negative": "node scripts/verify-site.mjs --self-test"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "knip": "6.46.1",
    "oxlint": "1.94.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
