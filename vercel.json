{
  "buildCommand": "pnpm build:release",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": { "re": "text/markdown" }
        }
      ],
      "dest": "/en/index.md"
    },
    {
      "src": "^/(en|ko)/$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": { "re": "text/markdown" }
        }
      ],
      "dest": "/$1/index.md"
    },
    {
      "src": "^/(en|ko)/(about|contact|privacy)/$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": { "re": "text/markdown" }
        }
      ],
      "dest": "/$1/$2/index.md"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/:locale(en|ko)/",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/:locale(en|ko)/index.md",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/:locale(en|ko)/:page(about|contact|privacy)/",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/:locale(en|ko)/:page(about|contact|privacy)/index.md",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
