{
  "buildCommand": "pnpm build:release",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        { "type": "header", "key": "accept", "value": ".*text/markdown.*" }
      ],
      "destination": "/en/index.md"
    },
    {
      "source": "/:locale(en|ko)/",
      "has": [
        { "type": "header", "key": "accept", "value": ".*text/markdown.*" }
      ],
      "destination": "/:locale/index.md"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/:locale(en|ko)/",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/:locale(en|ko)/index.md",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
